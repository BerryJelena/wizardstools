---
import { getCollection } from "astro:content"

import { PROFILE, SITE } from "@site-config"
import { PostManager } from "@/lib/blog"
import { loadSelectedPublications } from "@/lib/publications/loader"
import { getLatestUpdates } from "@/lib/updates"
import Layout from "@/layouts/Layout.astro"
import Button from "@/components/base/Button.astro"
import { CardGroup } from "@/components/base/card"
import PreviewCard from "@/components/blog/PreviewCard.astro"
import Section from "@/components/layout/Section.astro"
import Profile from "@/components/profile/Profile.astro"
import PubCard from "@/components/publications/PubCard.astro"
import ExperienceTimeline from "@/components/timeline/ExperienceTimeline.astro"
import UpdatesInline from "@/components/timeline/UpdatesInline.astro"

import {
  Content as MiscContent,
  rawContent as miscRaw,
} from "@/content/misc.md"
import {
  Content as ServicesContent,
  rawContent as servicesRaw,
} from "@/content/services.md"

import "@/styles/callout.css"

const hasServices = servicesRaw().trim().length > 0
const hasMisc = miscRaw().trim().length > 0

const careerHighlights = await getCollection("experience")
const careerHighlightCount = SITE.home.careerHighlightCount
const cvHref =
  typeof PROFILE.links.cv === "object"
    ? PROFILE.links.cv?.href
    : PROFILE.links.cv
const renderedUpdates = await getLatestUpdates(3)
const selectedPublications = await loadSelectedPublications()

// Blog
const postManager = PostManager.getInstance()
const recentPosts = await postManager.getMainPosts(SITE.blog.featuredPostCount)
const recentPostsMetadata = await Promise.all(
  recentPosts.map((post) => postManager.getMetadata(post.id)),
)
---
---
// Puedes importar componentes o definir datos de tus proyectos aquí
const proyectos = [
  { titulo: "Wizard App", link: "/wizard-app", portada: "/covers/wizard.jpg", estante: "En desarrollo" },
  { titulo: "Masterlist", link: "/masterlist", portada: "/covers/masterlist.jpg", estante: "En desarrollo" },
  { titulo: "Audit Tool", link: "https://ejemplo.com", portada: "/covers/audit.jpg", estante: "Completados" }
];
---



<Layout title="Home">
  <Profile profile={PROFILE} />

  <!-- SECCIÓN DE ESTANTERÍA / BOOKCASE DE PROYECTOS -->
  <Section title="Library & Tools" id="bookcase">
    <div class="bookcase-container">
      
      <!-- Repisa 1: En desarrollo -->
      <div class="shelf-category">
        <h3 class="shelf-subtitle">En desarrollo</h3>
        <div class="shelf-row">
          <a href="#" class="book-card">
            <div class="book-cover"></div>
            <span class="book-label">Wizard App</span>
          </a>
          <a href="#" class="book-card">
            <div class="book-cover"></div>
            <span class="book-label">Masterlist</span>
          </a>
        </div>
      </div>

      <!-- Repisa 2: Completados -->
      <div class="shelf-category">
        <h3 class="shelf-subtitle">Completados</h3>
        <div class="shelf-row">
          <a href="#" class="book-card">
            <div class="book-cover"></div>
            <span class="book-label">Audit Tool</span>
          </a>
        </div>
      </div>

    </div>
  </Section>

  {careerHighlightCount > 0 && careerHighlights.length > 0 && (
      <Section
        title="Career highlights"
        moreLink={cvHref}
        moreText="see CV →"
      >
        <ExperienceTimeline entries={careerHighlights} limit={careerHighlightCount} />
      </Section>
    )}

  {renderedUpdates.length > 0 && (
      <Section title="Latest updates" moreLink="/now">
        <UpdatesInline renderedUpdates={renderedUpdates} itemClass="home-update-content" />
      </Section>
    )}

  {selectedPublications.length > 0 && (
      <Section title="Selected publications" moreLink="/publications">
        <CardGroup class="selected-publications">
          {selectedPublications.slice(0, 3).map((pub) => (
            <PubCard pub={pub} filterableTags={false} />
          ))}
        </CardGroup>
      </Section>
    )}
  {recentPostsMetadata.length > 0 && (
      <Section title="Latest posts">
        <ul class="latest-posts-list">
          {recentPostsMetadata.map((metadata) => (
            <li>
              <PreviewCard metadata={metadata} />
            </li>
          ))}
        </ul>
        <div class="latest-posts-actions">
          <Button href="/blog" variant="default" class="home-arrow-button">
            See all posts <span aria-hidden="true">&rarr;</span>
          </Button>
          <Button href="/blog/tags" variant="ghost" class="home-arrow-button">
            Browse by tags <span aria-hidden="true">&rarr;</span>
          </Button>
        </div>
      </Section>
    )}

  {hasServices && (
      <Section title="Services">
        <prose-content>
          <ServicesContent />
        </prose-content>
      </Section>
    )}

  {hasMisc && (
      <Section title="Miscellaneous">
        <prose-content>
          <MiscContent />
        </prose-content>
      </Section>
    )}
</Layout>

<style>
  /* ESTILOS DE LA ESTANTERÍA (BOOKCASE) */
  .bookcase-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding: 1.5rem;
    background-color: #faf7f2;
    border: 8px solid #e8dec8;
    border-radius: 12px;
    margin-block-end: var(--space-m);
  }

  .shelf-subtitle {
    font-size: 1.1rem;
    font-weight: 600;
    color: #6b5344;
    margin-bottom: 1rem;
    border-bottom: 2px solid #e0d1bc;
    padding-bottom: 0.25rem;
  }

  .shelf-row {
    display: flex;
    gap: 1.5rem;
    align-items: flex-end;
    padding: 0 1rem;
    position: relative;
    min-height: 150px;
  }

  /* Repisa física de madera */
  .shelf-row::after {
    content: "";
    position: absolute;
    bottom: -8px;
    left: 0;
    right: 0;
    height: 10px;
    background: linear-gradient(180deg, #d4b595 0%, #b8936d 100%);
    border-radius: 3px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.12);
  }

  .book-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    transition: transform 0.2s ease;
    z-index: 1;
  }

  .book-card:hover {
    transform: translateY(-6px) scale(1.03);
  }

  .book-cover {
    width: 95px;
    height: 135px;
    background-color: #d1c7b7;
    border-radius: 3px 6px 6px 3px;
    box-shadow: 3px 5px 10px rgba(0, 0, 0, 0.2);
    object-fit: cover;
  }

  .book-label {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: #4a3b32;
    text-align: center;
  }

  /* ESTILOS ORIGINALES DE TU PLANTILLA */
  .selected-publications {
    gap: var(--space-s);
  }

  .latest-posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .latest-posts-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-s);
  }

  :global(.home-arrow-button span[aria-hidden="true"]) {
    display: inline-block;
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  :global(.home-arrow-button:hover span[aria-hidden="true"]) {
    transform: translateX(0.25rem);
  }

  :global(.home-update-content) {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;

    @media (width >= 48rem) {
      -webkit-line-clamp: 3;
    }
  }
</style>